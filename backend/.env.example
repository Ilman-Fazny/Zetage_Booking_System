# Database
DATABASE_URL=postgresql://user:password@localhost:5432/zetage_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Event Details
EVENT_NAME="Zentage Talent Show"
EVENT_DATE="September 6, 2026"
EVENT_VENUE="Elphinstone Theatre, Maradana"
EVENT_PRICE=500

# PayHere Integration
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout
FRONTEND_URL=http://localhost:5173
PAYHERE_NOTIFY_URL=http://localhost:8000

# Resend Email Integration
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
